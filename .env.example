# From developers.kite.trade. The daily access token is NOT here: paste it in the app's token box.
KITE_API_KEY=

# Optional but recommended: a private key you choose. If set, open the app once
# as https://YOUR-APP.vercel.app/?key=THIS_VALUE (the browser remembers it).
ACCESS_KEY=

# Redis: add "Upstash Redis" from the Vercel Marketplace (Storage tab).
# It injects these automatically (either naming works):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
